{
  "name": "dsh-vibecode-studio",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "description": "DSH Vibecode Studio: in-chat preview, annotation, inspect and API workbench for DeepSeek Harness.",
  "license": "MIT",
  "packageManager": "pnpm@11.21.0",
  "main": "./lib/index.js",
  "exports": {
    ".": "./lib/index.js",
    "./agent": "./lib/agent.js",
    "./client": "./lib/client.js",
    "./package.json": "./package.json"
  },
  "files": [
    "lib",
    "presets",
    "skills",
    "cordis.patch.yml"
  ],
  "engines": {
    "node": ">=24",
    "dsh": ">=0.2.1-rc.2"
  },
  "dsh": {
    "bundle": {
      "patch": [
        "./cordis.patch.yml",
        "./presets/vibe-studio/cordis.patch.yml"
      ]
    },
    "client": {
      "platform": "web",
      "inject": [
        "@deepseek-ai/dsh-client-ui-renderer",
        "@deepseek-ai/dsh-client-ui-sidebar-right"
      ]
    }
  },
  "scripts": {
    "clean": "node scripts/clean.mjs",
    "typecheck": "tsc --noEmit",
    "build": "node scripts/build-host.mjs && node scripts/build-client.mjs",
    "build:host": "node scripts/build-host.mjs",
    "build:client": "node scripts/build-client.mjs",
    "test": "vitest run",
    "test:security": "vitest run tests/security",
    "test:e2e": "playwright test",
    "test:soak": "tsx tests/soak/run.ts",
    "fixture:dev": "vite --config fixtures/vite-basic/vite.config.ts --host 127.0.0.1 --port 4320 --strictPort",
    "spike:s1": "tsx spikes/s1/run.ts",
    "spike:s1:build": "tsx spikes/s1/run.ts --build-only",
    "spike:s1:soak": "node spikes/s1/soak.mjs",
    "spike:s2:build": "tsx spikes/s2/build.ts",
    "spike:s3": "tsx spikes/s3/run.ts",
    "spike:s4": "tsx spikes/s4/run.ts",
    "usage:cc": "node tools/cc-usage.mjs"
  },
  "devDependencies": {
    "@babel/core": "^7.29.7",
    "@playwright/test": "1.64.1",
    "@react-dev-inspector/babel-plugin": "2.0.1",
    "@sveltejs/vite-plugin-svelte": "^7.3.1",
    "@testing-library/dom": "^10.4.2",
    "@testing-library/react": "^16.3.3",
    "@types/node": "^24.10.0",
    "@types/react": "^18.3.27",
    "@types/react-dom": "^18.0.0",
    "@vitejs/plugin-react": "^6.1.2",
    "@vitejs/plugin-vue": "^6.0.10",
    "esbuild": "^0.28.2",
    "jpeg-js": "^0.4.4",
    "jsdom": "^30.1.3",
    "react": "^19.3.1",
    "react-dom": "^19.3.1",
    "svelte": "^5.57.2",
    "tsx": "^4.20.6",
    "typescript": "^5.9.3",
    "vite": "^8.3.5",
    "vite-plugin-vue-inspector": "^7.0.0",
    "vitest": "^5.0.5",
    "vue": "^3.5.44"
  },
  "dependencies": {
    "@deepseek-ai/schemastery": "~3.18.5",
    "playwright-core": "^1.56.1"
  }
}
